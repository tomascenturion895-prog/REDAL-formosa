# REDAL Formosa: variables de entorno.
# Copiá este archivo a `.env` (o `.env.local` para `npm run dev`) y completá los valores.
# `.env` está ignorado por git: nunca subas claves reales.
#
# Las variables NEXT_PUBLIC_* se incrustan al compilar (el Dockerfile las recibe como ARG).
# Si las cambiás, reconstruí la imagen. Las demás se leen en tiempo de ejecución y no llegan al navegador.

# ── Supabase (obligatorias) ─────────────────────────────────────────────────
# Panel de Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave de servicio: solo servidor (webhook de pagos, cuenta bancaria, scripts). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app, sin barra final. Mercado Pago vuelve a esta dirección tras el pago.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Mercado Pago (necesarias para cobrar) ───────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
# Opcional pero recomendada en producción: verifica la firma del webhook.
MERCADOPAGO_WEBHOOK_SECRET=

# ── Cuenta bancaria del vendedor (necesaria para guardarla) ─────────────────
# 32 bytes en base64. Generala con: openssl rand -base64 32
BANK_ENCRYPTION_KEY=
# Alternativa para rotar claves (tiene prioridad si está definida):
# BANK_ENCRYPTION_KEYRING={"currentId":"v2","keys":{"v1":"<base64>","v2":"<base64>"}}

# ── Voz y recetas (opcionales) ──────────────────────────────────────────────
# "Voz a catálogo", búsqueda por voz y recetas. Sin clave, esas funciones avisan que no están habilitadas.
OPENAI_API_KEY=
# Opcionales: cualquier proveedor con API compatible con OpenAI.
# OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=
# OPENAI_TRANSCRIBE_MODEL=
# Opcional: si está definida, la búsqueda por voz transcribe con AssemblyAI en lugar de OpenAI.
ASSEMBLYAI_API_KEY=

# ── Avisos por email y SMS (opcionales) ─────────────────────────────────────
# Sin estas claves el pedido se confirma igual, pero no se envían avisos.
SENDGRID_API_KEY=
# Debe ser un remitente verificado en SendGrid.
NOTIFICATIONS_FROM_EMAIL=noreply@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Scripts de datos de prueba (solo desarrollo) ────────────────────────────
# npm run seed / npm run seed:demo. Si no las definís, se usa una contraseña de demostración o una aleatoria.
# SEED_PASSWORD=
# DEMO_PASSWORD=
